NODE_ENV=development
PORT=5000
# Local MongoDB (no auth). Docker stack sets MONGODB_URI in compose (mongodb://mongo:27017/tms_hospital).
MONGODB_URI=mongodb://127.0.0.1:27017/tms_hospital
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5174
BCRYPT_SALT_ROUNDS=10
# Groq Cloud — https://console.groq.com/keys (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SEED_ADMIN_EMAIL=admin@tmshospital.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PHONE=9999999999

# Feedback System → TMS HTTP ingest (leave FEEDBACK_INGEST_TOKEN empty for open ingest; otherwise require header X-Feedback-Ingest-Token)
FEEDBACK_INGEST_TOKEN=
# Optional: Mongo ObjectId of the TMS user used for feedback-ingest audit logs (defaults to first active REQUESTER)
FEEDBACK_INGEST_REQUESTER_USER_ID=
